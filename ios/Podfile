# iOS 15.5 is not a preference — it is the floor ML Kit sets.
#
# There was no Podfile here at all, so CocoaPods fell back to its own default of
# iOS 13.0 and then refused to resolve, because `google_mlkit_commons` declares
# `s.ios.deployment_target = '15.5'`. The build failed at `pod install` with
# "requires a higher minimum iOS deployment version than your application is
# targeting", which reads like a project setting when it is really an absent
# file. Nothing else in the dependency set asks for more than 13.0.
#
# The version is stated in three places and they have to agree: here, in
# `IPHONEOS_DEPLOYMENT_TARGET` on the Runner target, and in the post-install
# hook below that forces it onto every pod. Flutter's own template ships this
# line commented out, which is why it was missing.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously, which adds latency to
# every build for no benefit here.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # `flutter_additional_ios_build_settings` raises pods to Flutter's own
      # minimum, which is below ours. Without this line a pod that declares a
      # lower target keeps it and Xcode warns on every build that the pod and
      # the app disagree.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
  end
end
